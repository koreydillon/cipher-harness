# ─────────────────────────────────────────────────────────────────────────────
# Cipher — Environment Configuration
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Keys already set in your shell environment always take priority over .env.
# Never commit .env to version control — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────


# ── Anthropic API ─────────────────────────────────────────────────────────────

# Your Anthropic API key (required unless LOCAL_MODEL=true).
# Obtain one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...


# ── Model settings ────────────────────────────────────────────────────────────

# Default Claude model to use.
# Aliases accepted at runtime via /model: sonnet | haiku | opus
# Full model IDs also accepted, e.g. claude-opus-4-6
# Default: claude-sonnet-4-6
#CIPHER_DEFAULT_MODEL=claude-sonnet-4-6

# Maximum tokens per response.
# Default: 8096
#CIPHER_MAX_TOKENS=8096


# ── Local / Ollama model ──────────────────────────────────────────────────────

# Set to true to bypass Anthropic and use a local Ollama model instead.
# ANTHROPIC_API_KEY is not required when this is enabled.
# Default: false
#LOCAL_MODEL=false

# Name of the local Ollama model to serve requests.
# Default: cipher
#CIPHER_MODEL=cipher

# Base URL for the Ollama OpenAI-compatible API endpoint.
# Default: http://localhost:11434/v1
#OLLAMA_URL=http://localhost:11434/v1


# ── Plugins ───────────────────────────────────────────────────────────────────

# Directory where Cipher looks for plugin tools (*.py files).
# Supports ~ expansion.
# Default: ~/.cipher/plugins
#CIPHER_PLUGIN_DIR=~/.cipher/plugins


# ── Budget ────────────────────────────────────────────────────────────────────

# Hard spend limit for a session in USD.
# The agent will refuse to make further API calls once this is reached.
# Can also be set at runtime with /budget <amount>.
# Leave unset for no limit.
#CIPHER_BUDGET=1.00


# ── Session logging ───────────────────────────────────────────────────────────

# Directory where session markdown logs are written (relative to cwd).
# Default: .cipher/sessions
#CIPHER_LOG_DIR=.cipher/sessions


# ── Context management ────────────────────────────────────────────────────────

# Fraction of the model's context window (0–1) that triggers auto-compaction.
# Lower values compact more aggressively; higher values allow longer contexts.
# Default: 0.85
#CIPHER_COMPACT_THRESHOLD=0.85


# ── Autonomous mode ───────────────────────────────────────────────────────────

# Start every session in autonomous mode (agent acts without confirmation).
# Can be toggled at runtime with /auto.
# Default: false
#CIPHER_AUTO_MODE=false
